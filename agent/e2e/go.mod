// Separate module so the testcontainers/Docker-SDK test dependencies stay out
// of the agent daemon's own module (agent/go.mod) — that module is what the
// Docker image build compiles, so it must stay lean. Not part of the repo
// go.work; run with GOWORK=off (the replacements below point at the local admin
// and agent modules), e.g.:
//
//	cd agent/e2e && GOWORK=off AWG_E2E=1 go test -run TestUserspaceTunnel -v .
module github.com/ks-tool/vpn-admin/agent/e2e

go 1.27.1

replace github.com/ks-tool/vpn-agent => ../

